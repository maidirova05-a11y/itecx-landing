# Локальный PostgreSQL, база itecx (полностью отдельная от ascora_education)
DATABASE_URL=postgresql://itecx_app:ПАРОЛЬ@localhost:5432/itecx
# SHA-256('itecx-admin-v1' + '::' + пароль администратора)
ADMIN_PASSWORD_HASH=REDACTED_ADMIN_PASSWORD_HASH
ADMIN_SALT=itecx-admin-v1
TOKEN_SECRET=случайная-строка-64-символа
PORT=3001
