# Локальный PostgreSQL, база itecx (полностью отдельная от ascora_education)
DATABASE_URL=postgresql://itecx_app:ПАРОЛЬ@localhost:5432/itecx
# SHA-256(ADMIN_SALT + '::' + пароль администратора)
# Сгенерировать: echo -n 'ВАШ_SALT::ВАШ_ПАРОЛЬ' | sha256sum
ADMIN_PASSWORD_HASH=ХЭШ_ПАРОЛЯ_АДМИНА
ADMIN_SALT=случайная-соль
TOKEN_SECRET=случайная-строка-64-символа
PORT=3001

# Необязательно: дублирование заявок в Bitrix24 CRM (сделка + контакт).
# Входящий вебхук с правом CRM: Bitrix24 → поиск "Вебхуки" → Входящий вебхук.
# Без этих двух переменных сайт работает как обычно, просто без CRM.
BITRIX_WEBHOOK_URL=https://azgroup.bitrix24.kz/rest/1/ВАШ_ТОКЕН
BITRIX_CATEGORY_ID=17
